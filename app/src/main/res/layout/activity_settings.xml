<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/title_settings" android:textSize="22sp" android:textStyle="bold" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_language" />
        <Spinner android:id="@+id/spLang"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_camera" />
        <Spinner android:id="@+id/spCamera"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_unit" />
        <Spinner android:id="@+id/spUnit"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_analysis_res" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/res_desc" />
        <Spinner android:id="@+id/spRes"
            android:layout_width="match_parent" android:layout_height="wrap_content" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_conf" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderConf"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0.2" android:valueTo="0.9" android:stepSize="0.05" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_smooth" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderSmooth"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="2" android:valueTo="15" android:stepSize="1" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchLabels"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_show_labels" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_motion" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/motion_desc" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMotion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0.1" android:valueTo="3.0" android:stepSize="0.05" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_min_speed" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/min_speed_desc" />
        <TextView android:id="@+id/tvMinSpeed"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/min_speed_off" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMinSpeed"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="5" android:stepSize="0.1" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_max_box" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/max_box_desc" />
        <TextView android:id="@+id/tvMaxBox"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="80%" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderMaxBox"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="10" android:valueTo="100" android:stepSize="5" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_ghost" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ghost_desc" />
        <TextView android:id="@+id/tvGhost"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="1.5" />
        <com.google.android.material.slider.Slider
            android:id="@+id/sliderGhost"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:valueFrom="0" android:valueTo="3" android:stepSize="0.5" />

        <Button android:id="@+id/btnTargets"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_targets" />

        <Button android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/save" />
    </LinearLayout>
</ScrollView>
