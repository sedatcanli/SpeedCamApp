<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigonometrik Kalibrasyon"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Hız = piksel hareketi x metre/piksel / süre. metre/piksel = 2 x Uzaklık x tan(FOV/2) / görüntü genişliği. Optik değerler telefondan otomatik okunur." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Telefondan okunanlar" android:textStyle="bold" />
        <TextView android:id="@+id/tvOptics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Okunuyor..." />

        <Button android:id="@+id/btnRefreshOptics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Telefondan tekrar oku" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Cisim uzaklığı (metre)" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Ölçüm yapılan nesnelerin kameraya uzaklığı (örn. yol 10 m)" />
        <EditText android:id="@+id/etDistance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Yatay görüş açısı FOV (derece)" />
        <EditText android:id="@+id/etFovH"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Dikey görüş açısı FOV (derece)" />
        <EditText android:id="@+id/etFovV"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <Button android:id="@+id/btnCalc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Hesapla ve önizle" />

        <TextView android:id="@+id/tvExample"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Örnek" />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Kaydet" />
    </LinearLayout>
</ScrollView>
