<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_calibration"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calib_desc" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/calib_mode" android:textStyle="bold" />
        <RadioGroup android:id="@+id/rgMode"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbManual"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/mode_manual" />
            <RadioButton android:id="@+id/rbAuto"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/mode_auto" />
        </RadioGroup>
        <TextView android:id="@+id/tvModeDesc"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/mode_auto_desc" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_optics_auto" android:textStyle="bold" />
        <TextView android:id="@+id/tvOptics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="..." />

        <Button android:id="@+id/btnRefreshOptics"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/btn_refresh_optics" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_distance" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/distance_desc" />
        <EditText android:id="@+id/etDistance"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_fov_h" />
        <EditText android:id="@+id/etFovH"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_fov_v" />
        <EditText android:id="@+id/etFovV"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <Button android:id="@+id/btnCalc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/btn_calc_preview" />

        <TextView android:id="@+id/tvExample"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="..." />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/label_ref_fine" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/ref_desc" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_real" />
        <EditText android:id="@+id/etReal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/label_shown" />
        <EditText android:id="@+id/etShown"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
        <Button android:id="@+id/btnCorrect"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/btn_apply_corr" />
        <TextView android:id="@+id/tvCorr"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="..." />

        <Button android:id="@+id/btnSave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/save" />
    </LinearLayout>
</ScrollView>
